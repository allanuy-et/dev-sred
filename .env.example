# SR&ED Manager — local dev env
# Copy to .env and fill in.

# Postgres connection string. Local example assumes Postgres running on default port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sred_manager

# JWT signing secret. Use any long random string for local; rotate for prod.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Origin of the web app, for CORS. In prod, this is your Vercel app URL.
WEB_ORIGIN=http://localhost:3000

# Where the Next.js app proxies /api/* to. In prod, this is the API Vercel URL.
API_URL=http://localhost:4000

# Set to "require" if your Postgres provider needs SSL (Vercel Postgres, Neon, etc.)
# DATABASE_SSL=require

# Anthropic API key — used by the "Generate SR&ED narrative" feature on the
# project detail page. The feature returns a 503 if this is unset; everything
# else works without it.
# ANTHROPIC_API_KEY=sk-ant-...

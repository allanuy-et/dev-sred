# SR&ED Manager — local dev env
# Copy to .env. Defaults below match the bundled docker-compose Postgres.

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sred_manager

# JWT signing secret. Any long random string is fine for local dev.
# Generate a fresh one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Origin of the web app, for CORS.
WEB_ORIGIN=http://localhost:3000

# Where the Next.js app proxies /api/* to.
API_URL=http://localhost:4000

# Uncomment if your Postgres provider requires SSL (managed Postgres, etc.).
# DATABASE_SSL=require

# Anthropic API key — used by the "Generate SR&ED narrative" feature on the
# project detail page. The feature returns a 503 if this is unset; everything
# else works without it.
# ANTHROPIC_API_KEY=sk-ant-...

# Where uploaded labour/expense attachments are written. Path is relative to
# the api workspace's CWD when started. Auto-created on first upload.
UPLOADS_DIR=./uploads
